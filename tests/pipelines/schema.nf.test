nextflow_pipeline {

    name "GAS Nomenclature JSON Output Schema Integration Testing"
    script "main.nf"

    test("Schema - Bad File") {
        tag "schema_bad_file"
        config "${projectDir}/tests/configs/iridanext_bad_file.config"

        when{
            params {
                input = "$baseDir/tests/data/samplesheets/samplesheet1.csv"
                outdir = "results"
            }
        }

        then {
            assert workflow.success

            def combined_stdout = workflow.stdout.join(",")

            assert combined_stdout.contains("JSON did not match schema")
            assert combined_stdout.contains('Validation errors: "call/Called/results.text"')
        }
    }

    test("Schema - Bad Metadata") {
        tag "schema_bad_metadata"
        config "${projectDir}/tests/configs/iridanext_bad_metadata.config"

        when{
            params {
                input = "$baseDir/tests/data/samplesheets/samplesheet1.csv"
                outdir = "results"
            }
        }

        then {
            assert workflow.success

            def combined_stdout = workflow.stdout.join(",")

            assert combined_stdout.contains("JSON did not match schema")
            assert combined_stdout.contains('Validation errors')
            assert combined_stdout.contains('id failed against')
        }
    }
}
